t_yuan（项目预算）、project.duration（项目周期）、project.expected_output（预期成果）、financial.annual_income_yuan（家庭年收入）、financial.household_size（家庭人数）、financial.hardship_status（困难认定状态）","schema":{"$defs":{"Evidence":{"additionalProperties":false,"properties":{"turn_id":{"maxLength":64,"minLength":1,"title":"Turn Id","type":"string"},"quote":{"maxLength":1500,"minLength":1,"title":"Quote","type":"string"}},"required":["turn_id","quote"],"title":"Evidence","type":"object"},"IntakeFact":{"additionalProperties":false,"properties":{"field":{"enum":["identity.name","identity.school","identity.college","identity.major","identity.grade","application.type","application.track","application.year","application.deadline","academic.gpa","academic.gpa_scale","academic.rank","academic.rank_total","academic.rank_percent","academic.rank_scope","academic.rank_period","academic.failed_courses","academic.english","award.name","award.level","award.prize","award.time","research.experience","research.output","service.role","service.period","service.volunteer_hours","project.name","project.problem","project.target_user","project.method","project.stage","project.team_size","project.member_role","project.advisor","project.budget_yuan","project.duration","project.expected_output","financial.annual_income_yuan","financial.household_size","financial.hardship_status"],"title":"Field","type":"string"},"record_id":{"maxLength":80,"minLength":1,"title":"Record Id","type":"string"},"value":{"anyOf":[{"maxLength":1500,"type":"string"},{"type":"null"}],"title":"Value"},"status":{"enum":["stated","approximate","negated","planned","conflict","unknown","withheld"],"title":"Status","type":"string"},"evidence":{"items":{"$ref":"#/$defs/Evidence"},"maxItems":8,"minItems":1,"title":"Evidence","type":"array"}},"required":["field","record_id","value","status","evidence"],"title":"IntakeFact","type":"object"}},"additionalProperties":false,"properties":{"schema_version":{"const":"student-intake-v1","title":"Schema Version","type":